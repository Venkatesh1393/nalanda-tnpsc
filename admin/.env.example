# Copy this file to .env.local for local development (never commit .env.local).
# Every variable consumed by the client MUST be prefixed with VITE_.

# Backend API — same backend as frontend/, admin-only endpoints live under
# /admin (RBAC-gated, backend/src/routes/admin/).
VITE_API_BASE_URL=http://16.16.67.27/api/v1

# Firebase Authentication — same Firebase project as frontend/ (identity
# verification only; authorization comes from the Nalanda-issued JWT's
# `role` claim, checked both here and, authoritatively, on the backend).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_APP_ENV=development
