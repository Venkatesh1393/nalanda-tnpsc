# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file — see .gitignore.

# --- Core ---
NODE_ENV=development
PORT=5000
API_VERSION=v1
# Comma-separated list — the Student Web App (frontend/, default Vite port
# 5173) and the Admin Panel (admin/, default Vite port 5180) are two
# separate origins hitting this same backend (docs/Architecture.md §1).
CORS_ORIGIN=http://localhost:5173,http://localhost:5180

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nalanda_tnpsc?retryWrites=true&w=majority

# --- JWT (Nalanda-issued session tokens, RS256 — see docs/Authentication.md) ---
# PEM key pairs, base64-encoded (e.g. `openssl base64 -A -in private.pem`).
JWT_ACCESS_PRIVATE_KEY_BASE64=
JWT_ACCESS_PUBLIC_KEY_BASE64=
JWT_REFRESH_PRIVATE_KEY_BASE64=
JWT_REFRESH_PUBLIC_KEY_BASE64=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=nalanda-tnpsc

# --- Firebase Admin SDK (Google Login + Email OTP identity verification) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM private key, base64-encoded, to avoid escaping newlines in a .env file.
FIREBASE_PRIVATE_KEY_BASE64=

# --- Cloudinary (avatar/content uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Razorpay (Sprint 4 Step 56, TEST MODE only — never live keys here) ---
# Dashboard → Settings → API Keys for the first two; Settings → Webhooks for
# the third (set when you configure the webhook URL — same secret on both
# sides). All three are optional at boot; leaving them blank disables
# checkout/webhook endpoints with a clear error instead of failing to start.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Anthropic (Sprint 4 Step 57, Premium AI Explanation) ---
# Console → Settings → API Keys. Optional at boot; leaving it blank disables
# the AI explanation endpoint with a clear error instead of failing to start.
ANTHROPIC_API_KEY=

# --- Logging ---
LOG_LEVEL=info

# --- Cache (Sprint 4 Step 67) --- `memory` needs nothing else and works out
# of the box; `redis` is accepted but not implemented yet (see config/cache.ts)
# — setting it today just logs a warning and falls back to memory.
CACHE_DRIVER=memory
REDIS_URL=
