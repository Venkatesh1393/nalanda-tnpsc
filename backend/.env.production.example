# Sprint 4 Step 68 — Production Readiness.
#
# The production counterpart to .env.example (development) and
# .env.test.example (test) — same variables, different values/expectations.
# Copy to .env on the actual production host/secret-manager, never commit
# the filled-in version (see .gitignore). Where a value differs meaningfully
# from development, that's called out below; where it doesn't, see
# .env.example's own comments instead of repeating them here.

# --- Core ---
NODE_ENV=production
PORT=5000
API_VERSION=v1
# The real Website/Student App/Admin Panel origins — never localhost.
# config/env.ts's validateProductionConfig() refuses to boot if this is "*",
# and warns (doesn't block) if it looks like localhost.
CORS_ORIGIN=https://app.nalanda-tnpsc.com,https://admin.nalanda-tnpsc.com

# --- MongoDB Atlas ---
# The PRODUCTION cluster/database — never the same database a developer's
# local .env or CI's .env.test points at. Use an Atlas user scoped to only
# this database, not the cluster-wide admin credentials.
MONGODB_URI=mongodb+srv://<prod-user>:<prod-password>@<cluster>.mongodb.net/nalanda_tnpsc?retryWrites=true&w=majority

# --- JWT --- Generate a DEDICATED production RS256 keypair — never reuse
# the keys committed for local dev anywhere in this repo's history/backups.
# `openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem`,
# then base64 each (`openssl base64 -A -in private.pem`). Store the private
# keys in your platform's secret manager, not in a file on the host.
JWT_ACCESS_PRIVATE_KEY_BASE64=
JWT_ACCESS_PUBLIC_KEY_BASE64=
JWT_REFRESH_PRIVATE_KEY_BASE64=
JWT_REFRESH_PUBLIC_KEY_BASE64=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=nalanda-tnpsc

# --- Firebase Admin SDK --- the production Firebase project's service
# account — never the same project used for local development/testing.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_BASE64=

# --- Cloudinary --- production cloud/account, separate media library from
# whatever a developer's local testing uploads into.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Rate limiting --- unchanged from development defaults unless real
# traffic patterns say otherwise; tune only with production metrics in hand.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Cache --- `memory` still works correctly in a single-instance
# deployment. The moment this runs as more than one instance behind a load
# balancer, switch to `redis` + provide REDIS_URL — `memory` is per-process,
# so two instances would each cache independently and could briefly disagree
# (a stale read on the instance that didn't just have its cache busted by an
# admin write). See config/cache.ts and docs/Deployment.md.
CACHE_DRIVER=memory
REDIS_URL=

# --- Razorpay --- LIVE mode keys (rzp_live_..., never rzp_test_...) plus the
# webhook secret configured on the LIVE webhook endpoint in the Razorpay
# Dashboard. All three must be set together in production — a checkout key
# without the webhook secret can create orders that never activate a
# subscription (config/env.ts's validateProductionConfig() warns on this).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Anthropic --- production API key. Blank is still tolerated (the AI
# Explanation endpoint fails gracefully), but AI features are effectively
# off until this is set.
ANTHROPIC_API_KEY=

# --- Logging --- `info` in production; drop to `warn` only if `info`-level
# volume becomes a real cost/noise problem, never as a default.
LOG_LEVEL=info
