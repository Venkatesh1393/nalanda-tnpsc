# Sprint 4 Step 68 — Production Readiness.
#
# The test counterpart to .env.example (development) and
# .env.production.example (production). No test runner is installed yet
# (see backend/tests/README.md — a deliberate, disclosed gap: a future step
# picks Vitest/Jest and confirms with the user first) — this file exists so
# that when one is, `NODE_ENV=test` and a real, isolated test database are
# already there to point it at, rather than tests accidentally running
# against development or (worse) production data.

# --- Core ---
NODE_ENV=test
PORT=5001
API_VERSION=v1
CORS_ORIGIN=http://localhost:5173,http://localhost:5180

# --- MongoDB Atlas ---
# A DEDICATED test database — different database name from development
# (nalanda_tnpsc) and production, ideally on a free/shared Atlas tier
# separate from the production cluster entirely. Tests that create/delete
# documents (the `verify:*` scripts' own pattern — see their header
# comments) must never be able to touch real user data.
MONGODB_URI=mongodb+srv://<test-user>:<test-password>@<cluster>.mongodb.net/nalanda_tnpsc_test?retryWrites=true&w=majority

# --- JWT --- a throwaway keypair is fine here (same tolerance as
# backend/.env's committed dev keys) since nothing testable depends on this
# being secret — generate one the same way as .env.example describes.
JWT_ACCESS_PRIVATE_KEY_BASE64=
JWT_ACCESS_PUBLIC_KEY_BASE64=
JWT_REFRESH_PRIVATE_KEY_BASE64=
JWT_REFRESH_PUBLIC_KEY_BASE64=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=nalanda-tnpsc

# --- Firebase Admin SDK --- a real project is still required (config/env.ts
# requires these unconditionally) — either a dedicated Firebase test
# project, or the same dev project if the test suite never depends on
# Firebase-side state isolation.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_BASE64=

# --- Cloudinary --- same story as Firebase above — real credentials
# required to boot, a dedicated test cloud is preferable so test uploads
# never mix into real media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Rate limiting --- generous in test so a fast test run never trips the
# limiter and produces a flaky failure unrelated to what's being tested.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000

# --- Cache --- always `memory` in test — a shared Redis would let one test
# run's cached data leak into the next.
CACHE_DRIVER=memory
REDIS_URL=

# --- Razorpay / Anthropic --- leave blank unless a specific test suite
# exercises them; both fail gracefully when unset (config/razorpay.ts,
# config/anthropic.ts), same as development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=

# --- Logging --- quiet by default so test output stays readable; raise to
# `debug` locally when actually diagnosing a failing test.
LOG_LEVEL=warn
