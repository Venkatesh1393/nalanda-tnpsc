# Copy this file to .env.local for local development (never commit .env.local).
# Every variable consumed by the client MUST be prefixed with VITE_ — Vite only
# exposes prefixed variables to browser code; anything else stays server-only
# by design and will not leak into the built bundle.

# Backend API (docs/API.md — base URL, versioned). Matches backend/.env's
# default PORT=5000.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Firebase Authentication (docs/Authentication.md — Google Login, Email OTP,
# and Email/Password identity verification). These are public client config
# values, not secrets — Firebase's actual security boundary is server-side
# rules/Admin SDK verification, per docs/Architecture.md §4. Firebase Console
# > Project Settings > General > Your apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Razorpay (docs/Architecture.md §6) — publishable key ID ONLY.
# The secret key lives exclusively in the backend and must never appear here.
VITE_RAZORPAY_KEY_ID=

# Cloudinary (docs/Architecture.md §10) — cloud name for client-side signed
# upload widgets. The upload signature itself is issued by the backend
# (POST /profile/photo-upload-signature, docs/API.md §11), never generated
# client-side.
VITE_CLOUDINARY_CLOUD_NAME=

# Deployment environment — drives environment-specific behavior (e.g.
# verbose logging in development only). One of: development | staging | production
VITE_APP_ENV=development
