# Sprint 4 Step 71 — Production Frontend Deployment.
#
# The production counterpart to .env.example (development). Vite inlines
# every VITE_* variable into the built JS at BUILD time, not read at
# container runtime like the backend's .env — so these values are never
# copied to a `.env` on the production host. They're supplied as Docker
# `--build-arg`s (Dockerfile) or GitHub Actions repository secrets consumed
# by the CD pipeline, per docs/DEPLOYMENT_GUIDE.md Phase 3 §2. This file
# exists purely so "what does production need filled in" has one place to
# read, mirroring backend/.env.production.example's role.
#
# None of these are secrets (see .env.example's own header) — they're public
# client config. The real security boundary is server-side (Firebase
# Admin SDK verification, Razorpay webhook signature, backend RBAC).

# The real api.<domain> gateway host (nginx/gateway.conf) — never localhost
# and never an http:// origin in production (mixed-content + no HSTS).
VITE_API_BASE_URL=https://api.nalanda-tnpsc.com/api/v1

# Production Firebase project's Web App config (Firebase Console > Project
# Settings) — the SAME production project backend/.env.production.example's
# FIREBASE_* Admin SDK values point at, never the local-dev project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Razorpay LIVE publishable key (rzp_live_..., never rzp_test_...) — must
# match the LIVE key pair backend/.env.production.example's RAZORPAY_KEY_ID
# uses, or checkout will create orders the backend's webhook can't verify.
VITE_RAZORPAY_KEY_ID=

# Production Cloudinary cloud name — same account
# backend/.env.production.example's CLOUDINARY_CLOUD_NAME points at.
VITE_CLOUDINARY_CLOUD_NAME=

# Drives production-only behavior (env.ts's isProduction) — e.g. disables
# the /dev/preview design-system route's dev conveniences. Always
# "production" for a real production build; never left as "development".
VITE_APP_ENV=production
